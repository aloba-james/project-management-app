# Express API
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Shared Postgres for Next.js workspace/brain APIs (same DB as server).
# Leave unset to inherit from ../server/.env in local monorepo.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/project_management?schema=public

# Clerk (when both are set, workspace auth + login use Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login

# NextAuth fallback (used when Clerk keys are not set)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=local-dev-secret-change-me-before-production

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (https://github.com/settings/developers)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
